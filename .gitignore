# ==========================================
# GhostPad Landing Page — .gitignore
# ==========================================

# Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editores & IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Bundlers (caso venha a ser utilizado)
node_modules/
.npm/
dist/
build/
.cache/
.parcel-cache/

# Ambientes & Segredos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Arquivos temporários de backup
*.bak
*.tmp
*.orig
